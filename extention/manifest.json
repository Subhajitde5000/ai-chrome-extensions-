{
  "manifest_version": 3,
  "name": "MCQ Auto Solver",
  "version": "2.0",
  "description": "Auto-detects MCQ questions on any webpage and shows answers. Pauses when tab is not focused.",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MCQ Auto Solver"
  }
}
